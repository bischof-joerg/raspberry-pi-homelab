{
  "mode": "transition",
  "self_protect": true,
  "max_nesting_depth": 5,
  "write_dir": ".claude",
  "self_protected_paths": ["hooks", "settings.json", "settings.local.json", ".gitignore"],
  "allowed_temp_prefixes": ["/tmp/claude-"],
  "allowed_write_prefixes": ["~/.claude/plans/"],
  "null_targets": ["/dev/null"],
  "pi_identifiers": ["rpi-hub", "rpi-hub.fritz.box", "192.168.178.29"],
  "secret_dir_names": ["secrets"],
  "secret_suffixes": [".env", ".kdbx", ".keyx", ".pem", ".key", ".p12", ".pfx"],
  "secret_suffix_exceptions": [".env.example"],
  "secret_path_prefixes": [
    "~/.ssh",
    "~/.gnupg",
    "~/.config/renovate",
    "/etc/raspberry-pi-homelab"
  ],
  "pi_script_fragments": [
    "scripts/host/",
    "scripts/host-runtime/",
    "scripts/network/"
  ],
  "pi_script_basenames": ["deploy.sh", "init-permissions.sh"],
  "shell_heads": ["bash", "sh", "zsh", "dash", "ksh"],
  "interpreter_heads": ["python", "python3", "perl", "ruby", "node"],
  "interpreter_inline_flags": ["-c", "-e", "-E", "-i", "--eval", "-"],
  "denied_git_subcommands": [
    "commit",
    "push",
    "tag",
    "merge",
    "rebase",
    "reset",
    "checkout",
    "switch",
    "stash",
    "add",
    "rm",
    "am",
    "cherry-pick",
    "revert",
    "clean",
    "config"
  ],
  "write_git_subcommands": ["apply"],
  "remote_heads": [
    "ssh",
    "scp",
    "sftp",
    "rsync",
    "mosh",
    "nc",
    "ncat",
    "socat",
    "telnet",
    "ansible",
    "ansible-playbook"
  ],
  "operator_only_heads": ["gh"],
  "host_mutation_heads": [
    "sudo",
    "su",
    "doas",
    "ufw",
    "systemctl",
    "systemd-run",
    "usermod",
    "useradd",
    "groupadd",
    "groupmod",
    "apt",
    "apt-get",
    "rpi-eeprom-update",
    "rpi-update"
  ],
  "denied_heads": ["pre-commit", "gpg", "gpg2"],
  "write_heads": [
    "rm",
    "mv",
    "cp",
    "ln",
    "touch",
    "mkdir",
    "rmdir",
    "chmod",
    "chown",
    "chgrp",
    "truncate",
    "install",
    "dd",
    "tee",
    "patch",
    "shred"
  ],
  "target_last_operand_heads": ["cp", "mv", "ln", "install"],
  "mode_operand_heads": ["chmod", "chown", "chgrp", "install"],
  "secret_read_heads": [
    "cat",
    "less",
    "more",
    "head",
    "tail",
    "grep",
    "rg",
    "egrep",
    "fgrep",
    "awk",
    "sed",
    "source",
    ".",
    "base64",
    "xxd",
    "od",
    "strings",
    "cp",
    "mv",
    "tar",
    "zip"
  ],
  "allowed_make_targets": ["doctor", "doctor-strict", "help"],
  "allowed_docker_subcommands": ["version", "info", "ps", "images"],
  "allowed_docker_compose_subcommands": ["config"],
  "allowed_pip_subcommands": ["list", "show", "check", "freeze"],
  "nested_exec_heads": ["eval", "xargs", "find", "watch", "flock"]
}
